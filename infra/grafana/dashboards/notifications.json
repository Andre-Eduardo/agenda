{
  "uid": "agenda-notifications",
  "title": "Agenda · Notificações",
  "tags": [
    "agenda"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Tentativas de envio por resultado",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, outcome) (increase(notification_reminder_attempt_total[$__rate_interval]))",
          "legendFormat": "{{channel}} {{outcome}}"
        }
      ],
      "description": "sent = aceito pelo provider; retry = falhou e foi reagendado (até 3 tentativas); failed = falha definitiva."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Taxa de falha de envio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (channel) (rate(notification_reminder_attempt_total{outcome!=\"sent\"}[$__rate_interval])) / sum by (channel) (rate(notification_reminder_attempt_total[$__rate_interval]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Status reportados pelos providers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel, type) (increase(notification_reminder_status_total[$__rate_interval]))",
          "legendFormat": "{{channel}} {{type}}"
        }
      ],
      "description": "Eventos de webhook aplicados à linha do tempo: DELIVERED, READ, REPLIED, DELIVERY_FAILED, COMPLAINED."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência do provider (p95)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(notification_provider_send_duration_ms_bucket[$__rate_interval])))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Webhooks recebidos por resultado",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source, result) (increase(notification_webhook_received_total[$__rate_interval]))",
          "legendFormat": "{{source}} {{result}}"
        }
      ],
      "description": "unauthorized = token/assinatura inválidos; unmatched = mensagem que não é lembrete; duplicate = reentrega ignorada."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lembretes atrasados na fila",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(notification_reminders_overdue)",
          "legendFormat": "atrasados"
        }
      ],
      "description": "PENDING com horário vencido há mais de 15 minutos. Acima de zero = job de envio parado.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Entregues / enviados (24h)",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (channel) (increase(notification_reminder_status_total{type=\"DELIVERED\"}[24h])) / sum by (channel) (increase(notification_reminder_attempt_total{outcome=\"sent\"}[24h]))",
          "legendFormat": "{{channel}}",
          "instant": true
        }
      ],
      "description": "Aproximação: um lembrete lido antes do ack de entrega conta só como READ.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Logs de envio e webhooks",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"agenda-.+\"} |~ \"Reminder|EvolutionWhatsApp|SesEmail|Webhook\""
        }
      ]
    }
  ]
}
