DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=agenda
DATABASE_HOST=localhost

DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Seleciona o provider de chat clínico ativo.
# Valores: mock (padrão, sem API key) | openrouter
AI_CHAT_PROVIDER=mock

# OpenRouter — https://openrouter.ai/keys
# Necessário apenas quando AI_CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# URL base da API do OpenRouter. Padrão: https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo global no formato "provider/model" do OpenRouter.
# Usado pelo ChatModelProvider (fluxo legado). Cada agente pode ter seu próprio modelo via AGENT_*_MODEL.
# Exemplos: openai/gpt-4o | anthropic/claude-sonnet-4 | google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o
# Nome da aplicação — enviado como header X-Title ao OpenRouter
OPENROUTER_APP_NAME=App de Saúde
# URL da aplicação — enviado como header HTTP-Referer ao OpenRouter
OPENROUTER_APP_URL=https://seuapp.com.br

# ─── Embedding Provider ───────────────────────────────────────────────────────
# Desacoplado do chat — trocar AI_CHAT_PROVIDER nunca exige reindexação.
# Valores: mock (padrão, vetores aleatórios) | openai
AI_EMBEDDING_PROVIDER=mock

# OpenAI Embeddings — https://platform.openai.com/api-keys
# Necessário apenas quando AI_EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# Modelo de embeddings. Padrão: text-embedding-3-small (1536 dims).
# Alternativas: text-embedding-3-large (3072 dims) | text-embedding-ada-002 (1536 dims)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Agent Registry — Modelos por especialidade ───────────────────────────────
# Modelo para cada agente no formato OpenRouter: provider/model
# Altere e reinicie para usar outro modelo sem migration.
AGENT_GP_MODEL=anthropic/claude-sonnet-4
AGENT_PSY_MODEL=anthropic/claude-sonnet-4
AGENT_PHYSIO_MODEL=anthropic/claude-sonnet-4
AGENT_SPEECH_MODEL=anthropic/claude-sonnet-4
AGENT_NUTRI_MODEL=anthropic/claude-sonnet-4
AGENT_OT_MODEL=anthropic/claude-sonnet-4
AGENT_NURSE_MODEL=anthropic/claude-sonnet-4

# ─── Agent Registry — Parâmetros opcionais por agente ────────────────────────
# Tokens máximos de resposta (padrão: 1500 para GP e PSY, 1200 para demais)
AGENT_GP_MAX_TOKENS=1500
AGENT_PSY_MAX_TOKENS=1500
AGENT_PHYSIO_MAX_TOKENS=1200
AGENT_SPEECH_MAX_TOKENS=1200
AGENT_NUTRI_MAX_TOKENS=1200
AGENT_OT_MAX_TOKENS=1200
AGENT_NURSE_MAX_TOKENS=1200

# Temperatura de geração (0.0 = determinístico, 1.0 = criativo)
AGENT_GP_TEMPERATURE=0.3
AGENT_PSY_TEMPERATURE=0.4
AGENT_PHYSIO_TEMPERATURE=0.3
AGENT_SPEECH_TEMPERATURE=0.3
AGENT_NUTRI_TEMPERATURE=0.3
AGENT_OT_TEMPERATURE=0.3
AGENT_NURSE_TEMPERATURE=0.3

# Objetivos de análise por agente (CSV — obrigatório)
# Lista separada por vírgula do que o agente deve produzir em cada análise.
AGENT_GP_ANALYSIS_GOALS=resumo clínico,hipóteses diagnósticas,inconsistências,plano terapêutico
AGENT_PSY_ANALYSIS_GOALS=avaliação psicológica,hipóteses diagnósticas,fatores de risco,plano terapêutico
AGENT_PHYSIO_ANALYSIS_GOALS=avaliação funcional,hipóteses diagnósticas,plano de reabilitação,evolução clínica
AGENT_SPEECH_ANALYSIS_GOALS=avaliação fonoaudiológica,hipóteses diagnósticas,plano terapêutico,evolução clínica
AGENT_NUTRI_ANALYSIS_GOALS=avaliação nutricional,hipóteses diagnósticas,plano alimentar,evolução clínica
AGENT_OT_ANALYSIS_GOALS=avaliação ocupacional,hipóteses diagnósticas,plano de intervenção,evolução clínica
AGENT_NURSE_ANALYSIS_GOALS=avaliação de enfermagem,diagnósticos de enfermagem,plano de cuidados,evolução clínica

# Prioridade de contexto por agente (key:num — obrigatório)
# Fontes disponíveis: records, alerts, profile, forms. Menor número = maior prioridade.
AGENT_GP_CONTEXT_PRIORITY=records:1,alerts:2,profile:3,forms:4
AGENT_PSY_CONTEXT_PRIORITY=records:1,forms:2,profile:3,alerts:4
AGENT_PHYSIO_CONTEXT_PRIORITY=forms:1,records:2,profile:3,alerts:4
AGENT_SPEECH_CONTEXT_PRIORITY=forms:1,records:2,profile:3,alerts:4
AGENT_NUTRI_CONTEXT_PRIORITY=forms:1,records:2,profile:3,alerts:4
AGENT_OT_CONTEXT_PRIORITY=forms:1,records:2,profile:3,alerts:4
AGENT_NURSE_CONTEXT_PRIORITY=records:1,alerts:2,profile:3,forms:4

# ─── Gateway de Pagamento (Asaas) ────────────────────────────────────────────
# Autorizado pelo Banco Central (código 461). Suporta PIX, cartão e boleto.
# Crie sua conta em https://www.asaas.com e gere a API Key em Configurações > Integrações.
# Valores: sandbox | production
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token para validar autenticidade dos webhooks recebidos do Asaas.
# Configure em Asaas > Configurações > Webhooks > Chave de Acesso.
ASAAS_WEBHOOK_TOKEN=

# ─── Notificações: e-mail (Amazon SES) ───────────────────────────────────────
# Sem MAIL_FROM_ADDRESS os lembretes por e-mail usam o stub (só log, nada é enviado).
# O remetente (ou o domínio) precisa estar verificado no SES; em sandbox, o destinatário também.
# MAIL_FROM_ADDRESS=lembretes@suaclinica.com.br
# MAIL_REPLY_TO=contato@suaclinica.com.br
# Região do SES. Padrão: sa-east-1 (São Paulo).
# MAIL_SES_REGION=sa-east-1
# Sem chaves estáticas, usa a cadeia padrão de credenciais da AWS (role da instância/task).
# MAIL_SES_ACCESS_KEY_ID=
# MAIL_SES_SECRET_ACCESS_KEY=
# Rastreio de entrega (L2-04): configuration set do SES com destino de eventos num tópico SNS,
# e o ARN desse tópico. O webhook POST /api/v1/webhooks/ses só aceita mensagens assinadas pela
# AWS vindas deste tópico; sem o ARN ele recusa tudo. Ver docs/notification-providers.md.
# MAIL_SES_CONFIGURATION_SET=agenda-lembretes
# MAIL_SES_EVENTS_TOPIC_ARN=arn:aws:sns:sa-east-1:123456789012:agenda-ses-eventos

# ─── Notificações: WhatsApp (Evolution API) ──────────────────────────────────
# Sem URL e API key os lembretes por WhatsApp usam o stub (só log, nada é enviado).
# EVOLUTION_SERVER_URL=http://localhost:8080
# EVOLUTION_AUTHENTICATION_API_KEY=
# Cada clínica conecta o próprio número em Configurações > WhatsApp (instância Baileys com
# o id da clínica como nome, mesma convenção do plexter).
# Timeout de cada envio em ms. Padrão: 10000.
# EVOLUTION_TIMEOUT_MS=10000
# Rastreio de entrega e respostas (L2-04): segredo que assina o token por clínica do webhook
# POST /api/v1/webhooks/evolution/:clinicId. O webhook é registrado na instância ao conectar ou
# reconectar o WhatsApp. Sem o segredo nada é registrado e o webhook recusa tudo.
# EVOLUTION_WEBHOOK_SECRET=
# URL pública que a Evolution chama de volta. Padrão: PUBLIC_BASE_URL.
# EVOLUTION_WEBHOOK_BASE_URL=https://api.suaclinica.com.br

# ─── Observabilidade (OpenTelemetry → Grafana) ───────────────────────────────
# Desligado por padrão. Com true, exporta traces, métricas e logs via OTLP HTTP.
# Local: `docker compose up -d lgtm` (Grafana em http://localhost:3001, admin/admin).
# Ver docs/observability.md.
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=agenda-server
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana Cloud: endpoint OTLP do stack e header Basic base64(<instance-id>:<token>).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
# Fração dos traces amostrados (0 a 1). Padrão: 1.
# OTEL_TRACES_SAMPLER_ARG=1

# ─── Billing & Câmbio ────────────────────────────────────────────────────────
# Taxa de câmbio USD → BRL usada nos relatórios de custo de IA.
# Atualizar manualmente quando a taxa mudar. Nenhum redeploy de código necessário.
# Sem valor = 5.80 (padrão).
EXCHANGE_RATE_USD_BRL=5.80
