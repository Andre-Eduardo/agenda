# Variáveis usadas pelo próprio docker-compose.prod.yml (interpolação).
# Copie para deploy/.env e preencha. Nunca versione o arquivo real.

# ─── Imagens ───────────────────────────────────────────────────────────────
# Registro/prefixo e tag usados ao construir ou baixar as imagens.
IMAGE_REGISTRY=agenda
IMAGE_TAG=latest

# ─── PostgreSQL ────────────────────────────────────────────────────────────
# Use senha longa e aleatória só com caracteres seguros para URL (A-Z a-z 0-9 - _),
# porque ela entra na DATABASE_URL. Exemplo: openssl rand -hex 24
POSTGRES_USER=agenda
POSTGRES_PASSWORD=
POSTGRES_DB=agenda

# ─── Server ────────────────────────────────────────────────────────────────
# Aplica as migrations do Prisma ao iniciar o server.
RUN_MIGRATIONS=true
# LOCAL (volume Docker "uploads") ou S3 (configure STORAGE_S3_* em server.env).
STORAGE_TYPE=LOCAL

# ─── Web ───────────────────────────────────────────────────────────────────
# Onde o contêiner web é publicado no host. Com proxy TLS/load balancer próprio,
# mantenha em localhost; sem nenhum, use 0.0.0.0:80.
WEB_PUBLISH=127.0.0.1:8080
# Tamanho máximo de upload aceito pelo nginx (mantenha >= UPLOAD_FILE_MAX_SIZE).
CLIENT_MAX_BODY_SIZE=25m
# Só quando a API estiver em outra origem que não a do web (raro). Vazio = mesma origem.
VITE_API_URL=

# ─── HTTPS com Caddy (profile "tls") ───────────────────────────────────────
DOMAIN=agenda.example.com
ACME_EMAIL=ops@example.com

# ─── Backup ────────────────────────────────────────────────────────────────
# Diretório do host para os backups cifrados. Prefira um disco/montagem fora deste host.
BACKUP_HOST_DIR=./backups
# Chave de 32 bytes em hex (openssl rand -hex 32), modo 0600. Guarde uma cópia fora do host.
BACKUP_KEY_HOST_FILE=./secrets/backup.key
# Horário diário do backup em UTC (05:00 UTC = 02:00 em Brasília).
BACKUP_SCHEDULE_UTC=05:00
BACKUP_CHECK_INTERVAL_MINUTES=60
# Faz um backup assim que o contêiner sobe (false = só no horário agendado).
BACKUP_RUN_ON_START=true
BACKUP_MAX_AGE_HOURS=26
# Vazio = mantém todos os backups até a retenção ser aprovada (docs/backup-restore-runbook.md).
BACKUP_RETENTION_DAYS=
# Webhook que recebe falhas de backup/check (só serviço, comando, status e horário).
BACKUP_ALERT_URL=
